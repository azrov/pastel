{
  "name": "pastel-vscode",
  "displayName": "Pastel",
  "description": "Build cross-platform apps in Object Pascal with Pastel: run, build, live form preview, .pform completion and checks.",
  "version": "0.9.0",
  "publisher": "pastel",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "pascal",
    "object pascal",
    "free pascal",
    "delphi",
    "gui"
  ],
  "activationEvents": [
    "workspaceContains:**/pastel.toml",
    "onLanguage:pform",
    "onLanguage:pascal",
    "onView:pastel.project",
    "onDebugResolve:pastel",
    "onDebugDynamicConfigurations:pastel",
    "onDebugInitialConfigurations"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "pform",
        "aliases": [
          "Pastel Form",
          "pform"
        ],
        "extensions": [
          ".pform"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "pascal",
        "aliases": [
          "Pascal",
          "Object Pascal"
        ],
        "extensions": [
          ".pas",
          ".pp",
          ".inc",
          ".lpr",
          ".dpr"
        ],
        "configuration": "./pascal-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pform",
        "scopeName": "source.pform",
        "path": "./syntaxes/pform.tmLanguage.json"
      },
      {
        "language": "pascal",
        "scopeName": "source.pascal.pastel",
        "path": "./syntaxes/pascal.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "pform",
        "path": "./snippets/pform.json"
      },
      {
        "language": "pascal",
        "path": "./snippets/pascal.json"
      }
    ],
    "commands": [
      {
        "command": "pastel.run",
        "title": "Run",
        "category": "Pastel",
        "icon": "$(play)"
      },
      {
        "command": "pastel.build",
        "title": "Build",
        "category": "Pastel",
        "icon": "$(tools)"
      },
      {
        "command": "pastel.test",
        "title": "Run Tests",
        "category": "Pastel",
        "icon": "$(beaker)"
      },
      {
        "command": "pastel.buildRelease",
        "title": "Build Release",
        "category": "Pastel"
      },
      {
        "command": "pastel.buildTarget",
        "title": "Build for Platform...",
        "category": "Pastel"
      },
      {
        "command": "pastel.clean",
        "title": "Clean",
        "category": "Pastel"
      },
      {
        "command": "pastel.doctor",
        "title": "Check Setup (Doctor)",
        "category": "Pastel"
      },
      {
        "command": "pastel.newProject",
        "title": "New Project...",
        "category": "Pastel"
      },
      {
        "command": "pastel.openPreview",
        "title": "Open Form Designer",
        "category": "Pastel",
        "icon": "$(open-preview)"
      },
      {
        "command": "pastel.refreshSchema",
        "title": "Reload Control List",
        "category": "Pastel"
      },
      {
        "command": "pastel.toggleFormCode",
        "title": "Toggle Form / Code",
        "category": "Pastel",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "pastel.toggleDeclaration",
        "title": "Go to Declaration / Body",
        "category": "Pastel"
      },
      {
        "command": "pastel.refreshTree",
        "title": "Refresh",
        "category": "Pastel",
        "icon": "$(refresh)"
      },
      {
        "command": "pastel.runWatch",
        "title": "Run and Watch (again on every save)",
        "category": "Pastel"
      },
      {
        "command": "pastel.testWatch",
        "title": "Test and Watch (again on every save)",
        "category": "Pastel"
      },
      {
        "command": "pastel.formatAll",
        "title": "Format All Files",
        "category": "Pastel"
      },
      {
        "command": "pastel.sendRequest",
        "title": "Send Request",
        "category": "Pastel",
        "icon": "$(play)"
      },
      {
        "command": "pastel.migrate",
        "title": "Run Database Migrations",
        "category": "Pastel"
      },
      {
        "command": "pastel.migrateStatus",
        "title": "Database Migration Status",
        "category": "Pastel"
      },
      {
        "command": "pastel.newMigration",
        "title": "New Database Migration…",
        "category": "Pastel"
      },
      {
        "command": "pastel.completeClass",
        "title": "Complete Class (create missing method bodies)",
        "category": "Pastel"
      },
      {
        "command": "pastel.newForm",
        "title": "New Form…",
        "category": "Pastel"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pastel.openPreview",
          "when": "resourceLangId == pform || pastel.hasForm",
          "group": "navigation@1"
        },
        {
          "command": "pastel.toggleFormCode",
          "when": "resourceLangId == pform || pastel.hasForm",
          "group": "navigation@2"
        },
        {
          "command": "pastel.run",
          "when": "pastel.isProject && (resourceLangId == pform || resourceLangId == pascal || resourceLangId == objectpascal)",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "pastel.openPreview",
          "when": "resourceLangId == pform || pastel.hasForm"
        }
      ],
      "explorer/context": [
        {
          "command": "pastel.openPreview",
          "when": "resourceExtname == .pform",
          "group": "navigation@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "pastel.openPreview",
          "when": "resourceExtname == .pform",
          "group": "1_pastel"
        }
      ],
      "editor/context": [
        {
          "command": "pastel.openPreview",
          "when": "resourceLangId == pform || pastel.hasForm",
          "group": "navigation@1"
        },
        {
          "command": "pastel.toggleFormCode",
          "when": "resourceLangId == pform || pastel.hasForm",
          "group": "navigation@2"
        },
        {
          "command": "pastel.toggleDeclaration",
          "when": "editorLangId == pascal || editorLangId == objectpascal",
          "group": "navigation@3"
        }
      ],
      "view/title": [
        {
          "command": "pastel.run",
          "when": "view == pastel.project",
          "group": "navigation@1"
        },
        {
          "command": "pastel.build",
          "when": "view == pastel.project",
          "group": "navigation@2"
        },
        {
          "command": "pastel.refreshTree",
          "when": "view == pastel.project",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "pastel.sendRequest",
          "when": "view == pastel.project && viewItem == pastelRoute",
          "group": "inline"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "pastel",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "build",
              "run",
              "test",
              "clean",
              "check",
              "doctor",
              "fmt"
            ],
            "description": "The pastel command to run."
          },
          "target": {
            "type": "string",
            "description": "Platform to build for, e.g. windows or rpi (see 'pastel targets')."
          },
          "release": {
            "type": "boolean",
            "description": "Optimized build without debug information."
          },
          "watch": {
            "type": "boolean",
            "description": "Build and run again whenever a file is saved."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "pastel",
        "owner": "pastel",
        "source": "pastel",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "severity": "error",
        "pattern": {
          "regexp": "^(.+?)\\((\\d+)(?:,(\\d+))?\\)\\s+(Error|Fatal|Warning):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    ],
    "configuration": {
      "title": "Pastel",
      "properties": {
        "pastel.path": {
          "type": "string",
          "default": "pastel",
          "description": "Path to the pastel program. Leave as 'pastel' if it is on your PATH."
        },
        "pastel.checkWhileTyping": {
          "type": "boolean",
          "default": true,
          "description": "Check .pform files for mistakes while you type."
        },
        "pastel.delphiShortcuts": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Delphi-style keys in Pastel projects: **F9** run, **Ctrl+F9** build, **F12** switch between form and code, **Ctrl+Shift+Up/Down** jump between a method's declaration and body. Turn off to keep VS Code's own F9 (breakpoint) and F12 (go to definition)."
        },
        "pastel.serverUrl": {
          "type": "string",
          "default": "",
          "description": "Address for Send Request, e.g. http://localhost:8080. Empty: localhost with [server] port from config.toml."
        },
        "pastel.compileWhileTyping": {
          "type": "boolean",
          "default": true,
          "description": "Compile Pascal files in the background while you type and underline the compiler's errors."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pastel",
          "title": "Pastel",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "pastel": [
        {
          "id": "pastel.project",
          "name": "Project"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "pastel.project",
        "contents": "There is no Pastel project in this folder yet.\n[New Project](command:pastel.newProject)\n[Open Folder](command:vscode.openFolder)\nPastel builds apps for Linux, Windows, macOS and Raspberry Pi from Object Pascal."
      }
    ],
    "keybindings": [
      {
        "command": "pastel.run",
        "key": "f9",
        "when": "pastel.isProject && config.pastel.delphiShortcuts"
      },
      {
        "command": "pastel.build",
        "key": "ctrl+f9",
        "mac": "cmd+f9",
        "when": "pastel.isProject && config.pastel.delphiShortcuts"
      },
      {
        "command": "pastel.toggleFormCode",
        "key": "f12",
        "when": "config.pastel.delphiShortcuts && (editorLangId == pform || (editorTextFocus && pastel.hasForm) || activeWebviewPanelId == 'pastelPreview')"
      },
      {
        "command": "pastel.toggleDeclaration",
        "key": "ctrl+shift+up",
        "mac": "cmd+shift+up",
        "when": "config.pastel.delphiShortcuts && editorTextFocus && (editorLangId == pascal || editorLangId == objectpascal)"
      },
      {
        "command": "pastel.toggleDeclaration",
        "key": "ctrl+shift+down",
        "mac": "cmd+shift+down",
        "when": "config.pastel.delphiShortcuts && editorTextFocus && (editorLangId == pascal || editorLangId == objectpascal)"
      },
      {
        "command": "pastel.completeClass",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "editorTextFocus && editorLangId == pascal && pastel.isProject && config.pastel.delphiShortcuts"
      }
    ],
    "debuggers": [
      {
        "type": "pastel",
        "label": "Pastel",
        "languages": [
          "pascal",
          "pform"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments for the program.",
                "default": []
              },
              "project": {
                "type": "string",
                "description": "Folder of the project (with pastel.toml), if not the current one."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "pastel",
            "request": "launch",
            "name": "Debug Pastel program"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Pastel: Debug program",
            "description": "Build and debug the Pastel project",
            "body": {
              "type": "pastel",
              "request": "launch",
              "name": "Debug Pastel program",
              "args": []
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node ./out/test/unit.js && node ./out/test/edit.test.js && node ./out/test/designer.test.js && node ./out/test/pascal.test.js && node ./out/test/testparse.test.js && node ./out/test/routes.test.js && node ./out/test/analyzer.test.js",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "test:integration": "node ./out/test/integration.js",
    "apidoc": "node ./out/lang/apidoc.js ../framework/src ../docs/api"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.11.0",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^3.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.4.0"
  }
}
