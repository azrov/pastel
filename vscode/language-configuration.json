{
  "comments": {
    "lineComment": "//",
    "blockComment": ["{", "}"]
  },
  "brackets": [],
  "autoClosingPairs": [
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "{", "close": "}", "notIn": ["string"] }
  ],
  "surroundingPairs": [["'", "'"]],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*object\\s+\\w+\\s*:\\s*\\w+\\s*(//.*)?$",
    "decreaseIndentPattern": "^\\s*end\\b"
  },
  "folding": {
    "offSide": true,
    "markers": {
      "start": "^\\s*object\\b",
      "end": "^\\s*end\\b"
    }
  },
  "wordPattern": "(-?\\d+)|([A-Za-z_][A-Za-z0-9_]*)|('#[0-9A-Fa-f]*')"
}
