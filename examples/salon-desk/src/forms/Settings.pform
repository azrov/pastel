object SettingsForm: TSettingsForm
  Title = 'Settings'
  Width = 460
  Height = 460
  OnCreate = FormCreate
  object Memory: TFormMemory
    Fields = ('ServerEdit', 'KeyEdit', 'VatEdit', 'ShopMemo')
    FileName = 'settings.json'
  end
  object ServerLabel: TLabel
    Text = 'Server (for Sync)'
  end
  object ServerEdit: TEdit
    Placeholder = 'http://127.0.0.1:8080'
  end
  object KeyLabel: TLabel
    Text = 'API key (when the server asks for one)'
  end
  object KeyEdit: TEdit
    Password = True
  end
  object VatLabel: TLabel
    Text = 'VAT on invoices (%)'
  end
  object VatEdit: TNumberEdit
    Value = 20
    Max = 100
  end
  object ShopLabel: TLabel
    Text = 'The salon on invoices: its name, then its address'
  end
  object ShopMemo: TMemo
    Height = 80
    Text = 'Salon'
  end
  object Space: TSpacer
  end
  object Buttons: TRow
    Gap = 8
    Justify = End
    object CancelButton: TButton
      Text = 'Cancel'
      Style = Secondary
      ModalResult = mrCancel
      Cancel = True
    end
    object OkButton: TButton
      Text = 'OK'
      ModalResult = mrOk
      Default = True
    end
  end
end
