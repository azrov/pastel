{ Pastel - "pastel test": builds every unit in tests/ into one test program
  (with the project's own units available) and runs it.
  Part of the Pastel project, MIT License. }
unit Pastel.TestCmd;

{$mode objfpc}{$H+}

interface

uses
  SysUtils, Pastel.Project;

function RunProjectTests(Project: TPastelProject; const Filters: TStringArray;
  Json, Verbose: Boolean; NoRun: Boolean = False): Integer;

implementation

uses
  Classes, Process, Pastel.Console, Pastel.Targets, Pastel.Builder, Pastel.Env;

procedure FindTests(const Root, Rel: string; Units, Dirs: TStrings);
var
  SR: TSearchRec;
  Name: string;
  HasPas: Boolean;
begin
  HasPas := False;
  if FindFirst(Root + Rel + PathDelim + AllFilesMask, faAnyFile, SR) = 0 then
  try
    repeat
      if (SR.Name = '.') or (SR.Name = '..') or (SR.Name[1] = '.') then
        Continue;
      if (SR.Attr and faDirectory) <> 0 then
        FindTests(Root, Rel + PathDelim + SR.Name, Units, Dirs)
      else if LowerCase(ExtractFileExt(SR.Name)) = '.pas' then
      begin
        HasPas := True;
        Name := UnitNameOf(Root + Rel + PathDelim + SR.Name);
        if Name <> '' then
          Units.Add(Name);
      end;
    until FindNext(SR) <> 0;
  finally
    FindClose(SR);
  end;
  if HasPas then
    Dirs.Add(Rel);
end;

procedure WriteText(const FileName, Content: string);
var
  F: TFileStream;
begin
  ForceDirectories(ExtractFileDir(FileName));
  F := TFileStream.Create(FileName, fmCreate);
  try
    F.WriteBuffer(Content[1], Length(Content));
  finally
    F.Free;
  end;
end;

function RunProjectTests(Project: TPastelProject; const Filters: TStringArray;
  Json, Verbose: Boolean; NoRun: Boolean = False): Integer;
var
  Units, Dirs: TStringList;
  Opts: TBuildOptions;
  GenDir, MainRel, Src, ExePath, F: string;
  I: Integer;
  Proc: TProcess;
begin
  if not DirectoryExists(Project.Root + 'tests') then
  begin
    Warn('this project has no tests/ folder yet');
    Hint('add a unit like tests/greeting_test.pas; see docs/testing.md');
    Exit(0);
  end;
  Units := TStringList.Create;
  Dirs := TStringList.Create;
  try
    Units.Sorted := True;
    Units.Duplicates := dupIgnore;
    FindTests(Project.Root, 'tests', Units, Dirs);
    if Units.Count = 0 then
    begin
      Warn('no test units in tests/ (a test file starts with "unit Name;")');
      Exit(0);
    end;

    Opts := Default(TBuildOptions);
    Opts.Target := HostTarget;
    Opts.Verbose := Verbose;
    Opts.Quiet := True;
    Opts.Profile := 'test';
    Opts.OutName := Project.Name + '-tests';
    GenDir := 'build' + PathDelim + Opts.Target.Name + PathDelim + 'test' + PathDelim + 'gen';
    MainRel := GenDir + PathDelim + 'pastel_tests.pas';
    SetLength(Opts.ExtraDirs, Dirs.Count + 1);
    for I := 0 to Dirs.Count - 1 do
      Opts.ExtraDirs[I] := Dirs[I];
    Opts.ExtraDirs[Dirs.Count] := GenDir;
    SetLength(Opts.Defines, 1);
    Opts.Defines[0] := 'PASTEL_TEST';
    Opts.MainFile := MainRel;

    Src := '{ Generated by "pastel test" - do not edit. }' + LineEnding +
      'program pastel_tests;' + LineEnding + LineEnding +
      '{$mode objfpc}{$H+}' + LineEnding + LineEnding +
      'uses' + LineEnding + '  Pastel.Testing';
    for I := 0 to Units.Count - 1 do
      Src := Src + ',' + LineEnding + '  ' + Units[I];
    Src := Src + ';' + LineEnding + LineEnding +
      'begin' + LineEnding + '  Halt(RunTests);' + LineEnding + 'end.' + LineEnding;
    WriteText(Project.Root + MainRel, Src);

    if not Json then
      Status('Compiling', Format('%d test unit(s) of %s', [Units.Count, Project.Name]));
    if not BuildProject(Project, Opts, ExePath) then
      Exit(1);
    if NoRun then
    begin
      { for editors that start the tests in a debugger }
      WriteLn(Project.Root + ExePath);
      Exit(0);
    end;
    if not Json then
      WriteLn;

    Proc := TProcess.Create(nil);
    try
      Proc.Executable := Project.Root + ExePath;
      Proc.CurrentDirectory := Project.Root;
      for F in Filters do
        Proc.Parameters.Add(F);
      if Json then
        Proc.Parameters.Add('--json');
      for F in EnvList do
        Proc.Environment.Add(F);
      if UseColor then
        Proc.Environment.Add('PASTEL_COLOR=1');
      Proc.Options := [poWaitOnExit];
      Flush(Output);
      Proc.Execute;
      Result := Proc.ExitStatus;
    finally
      Proc.Free;
    end;
  finally
    Units.Free;
    Dirs.Free;
  end;
end;

end.
